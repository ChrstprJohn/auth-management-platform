NODE_ENV=development
HOST=127.0.0.1
PORT=3100
GOTRUE_URL=http://localhost:8081
# Server-only GoTrue service-role JWT. Never a browser/operator token.
GOTRUE_ADMIN_TOKEN=REPLACE_WITH_GOTRUE_ADMIN_TOKEN
# Keep disabled in production until platform-reference reconciliation is reviewed.
ALLOW_GLOBAL_USER_DELETION=false
ADMIN_DATABASE_URL=postgresql://ADMIN_ROLE:URL_ENCODED_PASSWORD@localhost:5432/admin_local_db
OPERATOR_UUID_ALLOWLIST=00000000-0000-4000-8000-000000000001
# Generate a dedicated key: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
FRONTEND_ORIGINS=http://localhost:5173
UPSTREAM_TIMEOUT_MS=5000
DATABASE_TIMEOUT_MS=5000
# false locally; use only the actual trusted Caddy IP/subnet in production.
TRUST_PROXY=false
LOG_LEVEL=info
