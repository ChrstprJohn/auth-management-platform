# Copy to .env and fill in development credentials. Never use production secrets.
# Existing PostgreSQL 17 container on local-database-server_default.
# URL-encode special characters in the username/password.
DATABASE_URL=postgres://auth_local:REPLACE_PASSWORD@local-database-server-postgres-1:5432/auth_local_db?search_path=auth
GOTRUE_DB_DRIVER=postgres
GOTRUE_DB_NAMESPACE=auth
GOTRUE_DB_MIGRATIONS_PATH=/usr/local/etc/auth/migrations

# Temporary direct local URL; gateway callback URLs follow when the API exists.
API_EXTERNAL_URL=http://localhost:8081
GOTRUE_SITE_URL=http://localhost:5173
GOTRUE_URI_ALLOW_LIST=http://localhost:5173/auth/callback,http://localhost:5174/auth/callback

# Replace with a randomly generated development-only secret (at least 32 bytes).
GOTRUE_JWT_SECRET=REPLACE_WITH_RANDOM_DEVELOPMENT_SECRET
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_ADMIN_ROLES=service_role
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_EXTERNAL_PHONE_ENABLED=false
GOTRUE_DISABLE_SIGNUP=false
# Signup requires email verification; development messages go to Mailpit.
GOTRUE_MAILER_AUTOCONFIRM=false
GOTRUE_SECURITY_REFRESH_TOKEN_ROTATION_ENABLED=true
GOTRUE_SECURITY_REFRESH_TOKEN_REUSE_INTERVAL=10

# Local Mailpit captures mail; replace with provider settings on the VM.
GOTRUE_SMTP_HOST=mailpit
GOTRUE_SMTP_PORT=1025
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=auth@local.test
GOTRUE_SMTP_SENDER_NAME=Local Auth
GOTRUE_MAILER_URLPATHS_CONFIRMATION=/verify
GOTRUE_MAILER_URLPATHS_INVITE=/verify
GOTRUE_MAILER_URLPATHS_RECOVERY=/verify
GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE=/verify
