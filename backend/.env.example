PORT=3000
GOTRUE_URL=https://auth.chrbuilds.dev
GOTRUE_ADMIN_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=0
# Set TRUST_PROXY=1 only on a private API behind one trusted Caddy proxy.
# Server-only privileged JWT; required for GoTrue user administration and validating membership/admin grants.
# On the VM Docker network use GOTRUE_URL=http://gotrue:8081
# Local PostgreSQL from compose.local.yml. Never use this password on the VM.
DATABASE_URL=postgresql://dashboard_app:local_dashboard_password@127.0.0.1:5433/dashboard_db?schema=dashboard
# Keep VM credentials in a VM-local .env, never in Git.
