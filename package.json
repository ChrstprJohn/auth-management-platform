{
  "name": "auth-management-platform",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @auth/gotrue-admin-api dev",
    "admin:token": "tsx scripts/generate-local-admin-token.ts",
    "operator:setup": "powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -File scripts/setup-local-operator.ps1",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "eslint": "10.11.0",
    "prettier": "3.8.3",
    "supertest": "7.2.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.0.18"
  }
}
